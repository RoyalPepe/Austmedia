{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/priser",
      "destination": "/#kontakt",
      "permanent": true
    },
    {
      "source": "/priser/",
      "destination": "/#kontakt",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "austmedia.vercel.app" }],
      "destination": "https://www.austmedia.no/:path*",
      "permanent": true
    }
  ]
}
